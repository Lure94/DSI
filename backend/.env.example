# Copia este archivo a .env (nunca subas el .env real a Git).
PORT=3000
# Opcional: TMDB (https://www.themoviedb.org/settings/api). Solo backend.
TMDB_READ_TOKEN=
# Solo para el primer arranque: crea una cuenta administradora real.
ADMIN_NAME=Administrador CineReview
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opcional: servicio de recuperación por correo (Resend).
RESEND_API_KEY=
EMAIL_FROM=
# URL pública al publicar el sitio (de forma local, usa este valor).
PUBLIC_URL=http://localhost:3000
